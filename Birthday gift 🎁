<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday Bestie! 🎉</title>

  <!-- Confetti Library -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    :root {
      --bg-color: #fff0f3;
      --card-bg: #ffffff;
      --primary-color: #ff6b81;
      --accent-color: #ff85a1;
      --text-color: #4a4a4a;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Comic Sans MS', 'Chalkboard SE', 'Segoe UI', sans-serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Screen Management (Expanded for Tablet Screens) */
    .screen {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      width: 95%;
      max-width: 760px; /* Scaled up for Tablet */
      padding: 25px;
      animation: fadeIn 0.5s ease-in-out;
    }

    .screen.active {
      display: flex;
    }

    /* Common Typography & Buttons (Enlarged) */
    h1 {
      color: var(--primary-color);
      font-size: 2.4rem;
      margin-bottom: 18px;
    }

    h2 {
      color: var(--primary-color);
      font-size: 2rem;
      margin-bottom: 15px;
    }

    h3 {
      color: var(--primary-color);
      font-size: 1.6rem;
      margin-bottom: 15px;
    }

    p {
      line-height: 1.7;
      margin-bottom: 16px;
      font-size: 1.15rem; /* Larger readable text */
    }

    .btn-group {
      display: flex;
      gap: 20px;
      margin-top: 20px;
      justify-content: center;
    }

    button {
      background-color: var(--primary-color);
      color: white;
      border: none;
      padding: 16px 32px;
      font-size: 1.15rem;
      font-weight: bold;
      border-radius: 30px;
      cursor: pointer;
      box-shadow: 0 6px 14px rgba(255, 107, 129, 0.3);
      transition: all 0.2s ease;
    }

    button:hover {
      transform: translateY(-2px) scale(1.04);
      background-color: var(--accent-color);
    }

    button.secondary-btn {
      background-color: #a4b0be;
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.1);
    }

    /* Screen 1: Cake (Larger Cake) */
    .cake-wrapper {
      position: relative;
      cursor: pointer;
      margin: 30px 0;
    }

    .cake-img {
      width: 300px; /* Increased from 220px */
      transition: transform 0.4s ease, filter 0.4s ease;
    }

    .cake-img.cut {
      transform: scaleX(0.92) rotate(-6deg);
      filter: drop-shadow(0 12px 20px rgba(0,0,0,0.15));
    }

    .cake-hint {
      font-size: 1.05rem;
      color: #888;
      margin-top: -10px;
    }

    /* Screen 2: Choice & Angry Sticker */
    .angry-container {
      display: none;
      margin-top: 25px;
      flex-direction: column;
      align-items: center;
    }

    .angry-sticker {
      width: 170px; /* Increased from 120px */
      height: auto;
      margin-bottom: 12px;
    }

    .shake {
      animation: shakeAnim 0.5s ease-in-out;
    }

    /* Screen 3: Flipbook Container (Tablet Optimized) */
    .book-container {
      width: 100%;
      height: 690px; /* Increased height for larger viewports */
      background: var(--card-bg);
      border-radius: 24px;
      box-shadow: 0 15px 35px rgba(0,0,0,0.12);
      padding: 25px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      border: 4px solid #ffe3e8;
    }

    /* 3D Flip Viewport */
    .pages-viewport {
      position: relative;
      width: 100%;
      height: 560px; /* Expanded Viewport height */
      perspective: 1400px;
    }

    .book-page {
      display: none;
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      padding: 15px;
      background: var(--card-bg);
      border-radius: 16px;
      overflow-y: auto;
      text-align: center;
      backface-visibility: hidden;
      transform-origin: left center;
      will-change: transform, opacity;
    }

    .book-page.active-page {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transform: rotateY(0deg);
      opacity: 1;
      z-index: 2;
    }

    .book-page h3 {
      text-align: center;
      border-bottom: 2px dashed #ffe3e8;
      padding-bottom: 12px;
      width: 100%;
    }

    /* Scattered Floating Images (Bigger Images & Adjustments) */
    .journey-wrapper {
      position: absolute;
      width: 500px;
      min-height: 500px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 50px 40px;
    }

    .journey-text {
      position: relative;
      z-index: 2;
      background: rgba(255, 255, 255, 0.95);
      padding: 22px;
      border-radius: 16px;
      box-shadow: 0 6px 20px rgba(255, 107, 129, 0.15);
      border: 1px solid #ffe3e8;
      max-width: 82%;
      font-size: 1.15rem;
    }

    .scattered-img {
      position: absolute;
      width: 180px; /* Increased from 75px */
      height: 180px; /* Increased from 75px */
      object-fit: cover;
      border-radius: 10px;
      border: 3px solid white;
      box-shadow: 0 6px 16px rgba(0,0,0,0.15);
      z-index: 1;
      animation: floatMotion 3.5s ease-in-out infinite alternate;
    }

    /* Scattered Positions tailored for larger tablet display */
    .img-pos-1 { top: -10px; left: -20px; transform: rotate(-10deg); animation-delay: 0s; }
    .img-pos-2 { top: 10px; right: 10px; transform: rotate(12deg); animation-delay: 0.7s; }
    .img-pos-3 { bottom: 10px; left: 15px; transform: rotate(8deg); animation-delay: 1.2s; }
    .img-pos-4 { bottom: 5px; right: 15px; transform: rotate(-14deg); animation-delay: 1.8s; }

    /* Canva Collage Image Styling (Significantly Enlarged) */
    .canva-wrapper {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-top: 10px;
    }

    .canva-img {
      width: 100%;
      max-height: 430px; /* Increased from 320px */
      object-fit: contain;
      border-radius: 16px;
      border: 3px dashed #ff85a1;
      box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

    /* Letter styling for high readability */
    .letter-body {
      padding: 20px 25px;
      text-align: left;
      font-size: 1.25rem;
      line-height: 1.8;
    }

    /* Motion Keyframes */
    @keyframes floatMotion {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-12px); }
    }

    .nav-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 2px solid #f8f8f8;
      width: 100%;
      z-index: 10;
    }

    /* Animations */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes shakeAnim {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-10px); }
      40%, 80% { transform: translateX(10px); }
    }
  </style>
</head>
